# Written by `npx convex dev` — the deployment this repo talks to.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Which face this build is: unset/club = the front desk console (and /me still
# works), coach = the coach's app only, whatever URL it is reached on. Set this
# to "coach" on a second Vercel project off this same repo to split the two
# products, or serve one build on a my./coach./pro. subdomain, which is detected
# at runtime. See src/face.ts.
VITE_APP_FACE=

# Public half of the VAPID pair, used by the browser to subscribe to push.
# Generate a pair with:  node -e "import('web-push').then(m=>console.log(m.default.generateVAPIDKeys()))"
VITE_VAPID_PUBLIC_KEY=

# --- Set on the Convex deployment, not here: `npx convex env set NAME value` ---
# OPENAI_API_KEY                  photo import, and both halves of Tempo. Without it the
#                                 assistant's mic button does not render at all.
# OPENAI_VISION_REASONING_EFFORT  low (default)
# OPENAI_AGENT_MODEL              Tempo's text model — gpt-5.6-luna (default)
# OPENAI_REALTIME_MODEL           Tempo's voice model — gpt-realtime-2 (default)
# OPENAI_REALTIME_VOICE           cedar (default)
# OPENAI_INSIGHT_MODEL            the rotating line on Insights — gpt-5.6-luna (default),
#                                 generated once per club per day and cached
# AI_MONTHLY_CEILING_USD          hard cap on a club's model spend per month — 25 (default)
# AI_MONTHLY_VOICE_CEILING_USD    the voice slice of that ceiling — 10 (default)
# BILLING_ENFORCED                set to "true" and clubs can no longer switch
#                                 themselves to Pro from Settings
# RESEND_API_KEY                  outbound email: coach invites and password
#                                 resets. Without it both still work — invites
#                                 just have to be passed on by hand.
# RESEND_FROM                     e.g. "Courtime <hello@courtime.app>"
# SITE_URL                        the address invite emails point people at
# VAPID_PUBLIC_KEY                same value as VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY               private half — never in the frontend
# VAPID_SUBJECT                   mailto: address for push, e.g. mailto:alerts@courtime.app
